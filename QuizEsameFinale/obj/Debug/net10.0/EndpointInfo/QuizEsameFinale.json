{
  "openapi": "3.1.1",
  "info": {
    "title": "QuizEsameFinale | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7110"
    },
    {
      "url": "http://localhost:5088"
    }
  ],
  "paths": {
    "/api/Exam/questions": {
      "get": {
        "tags": [
          "Exam"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Exam/submit": {
      "post": {
        "tags": [
          "Exam"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UserAnswerDto"
                }
              }
            },
            "text/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UserAnswerDto"
                }
              }
            },
            "application/*+json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UserAnswerDto"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserAnswerDto": {
        "type": "object",
        "properties": {
          "questionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "selectedOption": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Exam"
    }
  ]
}